# Public landing-page configuration
NEXT_PUBLIC_APP_NAME=Grocer
# WhatsApp number in Indian E.164 digits, for example 919876543210.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Server-only Next.js proxy target. Do not expose tokens to the browser.
BACKEND_INTERNAL_URL=

# FastAPI / Swiggy integration
COMMERCE_ADAPTER_TYPE=swiggy_mcp
CHECKOUT_MODE=review
# Keep false for the review-only release. Live checkout requires separate release gates.
LIVE_CHECKOUT_ENABLED=false
SWIGGY_REDIRECT_URI=https://grocerr.vercel.app/
SWIGGY_CLIENT_ID=
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# WhatsApp Cloud API. Use managed deployment secrets; never commit values.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PUBLIC_NUMBER=

# A durable database is required for signed webhook intake even in review mode. Copy the
# Supabase Session Pooler URI from Dashboard → Connect, use sslmode=require,
# and keep the password only in deployment secrets.
DATABASE_URL=
DATABASE_POOL_MAX_SIZE=5
# Base64 32-byte key for encrypting provider credentials at rest. Never expose it.
DATA_ENCRYPTION_KEY=
CORS_ALLOWED_ORIGINS=https://grocerr.vercel.app
