# ==============================================================================
# Grocer — Environment Variables Template
# Copy this file to .env and populate the actual secrets.
# ==============================================================================

# Application
APP_NAME=Grocer
ENVIRONMENT=development

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# LLM adapter (ADR 0012). Groq is the only provider.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=8.0
ROUTER_CONFIDENCE_FLOOR=0.70

# Money caps in paise (₹1,000 default; ₹1,00,000 ceiling)
DEFAULT_BUDGET_CAP_PAISE=100000
MAX_BUDGET_CAP_PAISE=10000000

# Database (Supabase PostgreSQL with SSL)
DATABASE_URL=
# Same Supabase project until launch, but a separate database: .../grocer_test
TEST_DATABASE_URL=
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5

# Deploy lock. Keep false. No real order is placed unless this is true.
LIVE_CHECKOUT_ENABLED=false

# Token Vault Encryption (32-byte Base64 key for AES-256-GCM)
DATA_ENCRYPTION_KEY=

# Swiggy MCP & OAuth 2.1
SWIGGY_REDIRECT_URI=https://grocerr.vercel.app/
SWIGGY_MCP_BASE_URL=https://mcp.swiggy.com

# Deployment & CORS
INTENT_BACKEND_URL=https://grocer-backend-qwk4.onrender.com
# Optional override used by the Next API routes before INTENT_BACKEND_URL.
BACKEND_INTERNAL_URL=
CORS_ALLOWED_ORIGINS=https://grocerr.vercel.app

# Landing page. Digits only, with country code. Never commit the real number.
NEXT_PUBLIC_WHATSAPP_NUMBER=
