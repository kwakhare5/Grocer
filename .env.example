# ==============================================================================
# Grocer v1.0 — Environment Variables Template
# Copy this file to .env and populate the actual secrets.
# ==============================================================================

# Application
APP_NAME=Grocer
ENVIRONMENT=development
LOG_LEVEL=INFO

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# LLM adapter (ADR 0012). Set the provider you want to use; groq is free.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini AI Models (kept for comparison and fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Database (Supabase PostgreSQL with SSL)
DATABASE_URL=
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5

# Token Vault Encryption (32-byte Base64 key for AES-256-GCM)
DATA_ENCRYPTION_KEY=

# Swiggy MCP & OAuth 2.1
COMMERCE_ADAPTER_TYPE=swiggy_mcp
SWIGGY_REDIRECT_URI=https://grocerr.vercel.app/
SWIGGY_MCP_BASE_URL=https://mcp.swiggy.com

# Deployment & CORS
INTENT_BACKEND_URL=https://grocer-backend-qwk4.onrender.com
CORS_ALLOWED_ORIGINS=https://grocerr.vercel.app
RENDER_API_KEY=
